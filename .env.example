# Configure a pooled Neon Postgres connection through Vercel Marketplace.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Generate a 32-byte random secret. Set in Vercel, never commit a real value.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Production only. Omit for Vercel previews.
BETTER_AUTH_URL=https://debt-app-ivory.vercel.app

# Optional: comma-separated account emails allowed to preview and clean orphaned private proof blobs.
# Omit or leave empty to disable administrative maintenance entirely.
DEBT_ADMIN_EMAILS=
# Attached by Vercel Blob storage integration; never commit a real token.
BLOB_READ_WRITE_TOKEN=

# Optional read-only creative AI provider (OpenAI-compatible chat/completions endpoint).
# Leave empty to disable AI entirely. Prompts must be explicitly submitted by opted-in users.
SCENE_AI_BASE_URL=
SCENE_AI_MODEL=
SCENE_AI_API_KEY=
