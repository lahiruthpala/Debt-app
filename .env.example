# Configure a pooled Neon Postgres connection through Vercel Marketplace.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Generate a 32-byte random secret. Set in Vercel, never commit a real value.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Production only. Omit for Vercel previews.
BETTER_AUTH_URL=https://debt-app-ivory.vercel.app
